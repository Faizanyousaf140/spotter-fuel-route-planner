# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example.com
# SQLITE_PATH=/absolute/path/db.sqlite3

# Vehicle model (assignment defaults)
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10

# Station corridor: max straight-line miles between a station's (city-level)
# coordinate and the route polyline.
MAX_OFF_ROUTE_MILES=15
ROUTE_SAMPLE_SPACING_MILES=2

# Routing: "osrm" (public demo server, no key) or "openrouteservice" (needs key)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_API_KEY=
ROUTING_CONNECT_TIMEOUT=5
ROUTING_READ_TIMEOUT=25
ROUTE_CACHE_SECONDS=604800

# Fallback geocoder for start/finish inputs the offline gazetteer cannot resolve
GEOCODER_FALLBACK_ENABLED=True
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim/OSRM policies require an identifying User-Agent (add a contact if deploying).
HTTP_USER_AGENT=spotter-fuel-route-planner/1.0 (Django coding assessment)

LOG_LEVEL=INFO
